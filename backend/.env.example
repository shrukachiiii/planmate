# Set these in your shell or IDE run configuration; Spring Boot does not load .env files by itself.
SERVER_PORT=8080
CORS_ALLOWED_ORIGIN=http://localhost:5173

# Optional MySQL profile settings (activate with SPRING_PROFILES_ACTIVE=mysql)
DB_URL=jdbc:mysql://localhost:3306/planmate?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=planmate
DB_PASSWORD=change-me
